# ============================================================
# .gitignore - Projet Standard (Ant + Tomcat 9 + Oracle 11g)
# ============================================================
# GARDE sous Git :
#   - arbiochem-war/src/**  et  arbiochem-war/web/**
#   - arbiochem-ejb/src/**  et  arbiochem-ejb/test/**
#   - build-file/lib/*.jar deja committes (dependances Ant, pas de Maven)
#   - scripts build*.xml, SQL AAAA-MM-JJ-HH_MM-*.sql, docs
# IGNORE : genere, archives redondantes, secrets, local, IDE, OS.

# --- Gros fichiers redondants (le vrai poids du repo) ---
# lib.zip = 107 Mo, les memes .jar sont deja presents un par un
# et aucun script de build ne reference cette archive.
build-file/lib/lib.zip
*.zip
*.psd

# --- Nouvelles dependances jar locales ---
# Les .jar deja committes restent suivis, mais on n'ajoute plus les
# 42 jars locaux (74 Mo) qui n'ont jamais ete committes.
# Pour forcer l'ajout d'un vrai nouveau jar : git add -f build-file/lib/mon.jar
build-file/lib/*.jar

# --- Genere par Ant / deploiement ---
build-file/arbiochem_war/
build-file/arbiochem_jar/
build-file/ear/
build-file/dist/
build-file/build/
deployments/
**/WEB-INF/classes/
**/target/
**/out/
*.war
*.ear
*.class

# --- Interdits par control/pre-commit (le commit serait bloque) ---
**/dateBuild.txt
**/apj.properties

# --- Secrets & config locale ---
**/testdoudou.txt
*.jks
*.p12
.env

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
nbproject/
.settings/
.classpath
.project

# --- OS ---
.DS_Store
._*
Thumbs.db
desktop.ini

# --- Logs & temporaires ---
*.log
logs/
checkbc/
C_Temp/
*.tmp
*.bak
*.orig
*.rej
*~
~$*

# --- Python (google-adk) ---
__pycache__/
*.pyc
.venv/
venv/
